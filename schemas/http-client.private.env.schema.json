{
  "$id": "https://raw.githubusercontent.com/dont-be-evil-company/kulala.nvim/main/schemas/http-client.private.env.schema.json",
  "title": "HTTP Client Private Environment Variables",
  "description": "The private environment variables required for the HTTP client",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$kulalaShared": {
      "type": "object",
      "description": "Kulala-only: variables and settings shared by all environments",
      "properties": {
        "$kulalaDefaultHeaders": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^([A-Za-z0-9_$]+)$": {
          "type": ["string", "number", "object"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^.*$": {
      "properties": {
        "$kulalaDefaultHeaders": {
          "type": "object",
          "description": "Kulala-only default HTTP headers for this environment",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^([A-Za-z0-9_]+)$": {
          "type": ["string", "number", "object"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
